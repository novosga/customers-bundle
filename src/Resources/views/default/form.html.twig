{% extends "@NovosgaCustomers/base.html.twig" %}

{% trans_default_domain 'NovosgaCustomersBundle' %}

{% block body %}
    <div class="d-flex">
        <div>
            <h1>
                <i class="fa fa-address-book" aria-hidden="true"></i> {{ 'title'|trans }}
            </h1>
            <p>{{ 'subtitle'|trans }}</p>
        </div>
        <div class="ms-auto mt-3">
            {% if entity.id %}
                <a href="{{ path('novosga_customers_tickets', { id: entity.id }) }}" class="btn btn-outline-secondary ms-2">
                    <i class="fa fa-history"></i>
                    {{ 'button.ticket_history'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {{ form_start(form) }}

        {% include 'flashMessages.html.twig' %}

        <div class="row">
            <div class="col-md-5">
                {{ form_row(form.nome) }}

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.documento) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(form.email) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.telefone) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.dataNascimento) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.genero) }}
                    </div>
                </div>

                {{ form_row(form.observacao) }}
            </div>
            <div class="col-md-6 offset-md-1">
                <fieldset>
                    <legend>{{ 'label.address'|trans({}, 'messages') }}</legend>
                    <div class="row">
                        <div class="col-md-4">
                            {{ form_row(form.endereco.pais) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.endereco.cep) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.endereco.estado) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            {{ form_row(form.endereco.cidade) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.endereco.logradouro) }}
                        </div>
                        <div class="col-md-2">
                            {{ form_row(form.endereco.numero) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            {{ form_row(form.endereco.complemento) }}
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-check"></i>
                {{ 'button.save'|trans }}
            </button>

            <a href="{{ path('novosga_customers_index') }}" class="btn btn-link text-decoration-none ms-2">
                <i class="fa fa-chevron-left"></i>
                {{ 'button.back'|trans }}
            </a>
        </div>

    {{ form_end(form) }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/novosgacustomers/js/script.js') }}"></script>
{% endblock %}
